        WriteSample { rows: .{ .{ "日a\r\n" }, .{ "b\t\na\r\n", "'x y7\né" }, .{ ",a", "日x y,", "日,", "", "é日\ta" } }, text: "'日a\r\n'\r\n'b\t\na\r\n'\t'''x y7\né'\r\n,a\t日x y,\t日,\t\t'é日\ta'\r\n" }
        WriteSample { rows: .{ .{ "7日\"", ",", "", "\r7'#", ";\r\n #" }, .{ "b," } }, text: "7日\"\t,\t\t'\r7''#'\t';\r\n #'\r\nb,\r\n" }
        WriteSample { rows: .{ .{ "#7é", "", "a", "'", "b a;" }, .{ "a", "\"b", "x y", "7x yb", "" }, .{ "\rb日" } }, text: "#7é\t\ta\t''''\tb a;\r\na\t\"b\tx y\t7x yb\t\r\n'\rb日'\r\n" }
        WriteSample { rows: .{ .{ "é日\r#" } }, text: "'é日\r#'\r\n" }
        WriteSample { rows: .{ .{ "éa 7", "", "" }, .{ "", "", "\r\na日", "\"\";;" } }, text: "éa 7\t\t\r\n\t\t'\r\na日'\t\"\";;\r\n" }
        WriteSample { rows: .{ .{ ";\r\n", "\"\n#" }, .{ "x y", "x yé'", "日", "x yx y", "7ab" } }, text: "';\r\n'\t'\"\n#'\r\nx y\t'x yé'''\t日\tx yx y\t7ab\r\n" }
        WriteSample { rows: .{ .{ "#7ab", "b", "" }, .{ "é7", ",日", "#b\"", "" }, .{ "\r\n", "", ";\nx y7'", "\"\na#" }, .{ "b;x y,\n" } }, text: "#7ab\tb\t\r\né7\t,日\t#b\"\t\r\n'\r\n'\t\t';\nx y7'''\t'\"\na#'\r\n'b;x y,\n'\r\n" }
        WriteSample { rows: .{ .{ "\"éé\r\n7", "", "#x y\r\n\r", "日ax y" }, .{ ";b\r\n" }, .{ "'x y\n", ",x yaaa", "\r\r\nx y日;", ";" }, .{ "", "7x yébb" } }, text: "'\"éé\r\n7'\t\t'#x y\r\n\r'\t日ax y\r\n';b\r\n'\r\n'''x y\n'\t,x yaaa\t'\r\r\nx y日;'\t;\r\n\t7x yébb\r\n" }
        WriteSample { rows: .{ .{ "", "x y\r", "\n\r7日", "\r\n \r\n#", "\"\n" }, .{ ",", "日\r\"日", "é \n日\r", "日'", "ab,\r" }, .{ "" } }, text: "\t'x y\r'\t'\n\r7日'\t'\r\n \r\n#'\t'\"\n'\r\n,\t'日\r\"日'\t'é \n日\r'\t'日'''\t'ab,\r'\r\n''\r\n" }
        WriteSample { rows: .{ .{ "#\r\nx y", "7'\r#", "", "", "a\n\n" }, .{ "", ";", "\n日7\r", "''" }, .{ "\nax ya", "\n'\" a", "\r\n", "\"" } }, text: "'#\r\nx y'\t'7''\r#'\t\t\t'a\n\n'\r\n\t;\t'\n日7\r'\t''''''\r\n'\nax ya'\t'\n''\" a'\t'\r\n'\t\"\r\n" }
        WriteSample { rows: .{ .{ "b", "#日\n7,", "b", "" }, .{ "", ";;" }, .{ "x y7", "\ra日a\"", "\r\n" }, .{ "b\né\na", ",\n7x yx y", "7" } }, text: "b\t'#日\n7,'\tb\t\r\n\t;;\r\nx y7\t'\ra日a\"'\t'\r\n'\r\n'b\né\na'\t',\n7x yx y'\t7\r\n" }
