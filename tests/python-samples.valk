        WriteSample { rows: .{ .{ "", "a", "日\"x ya", "\r\nx y" }, .{ "'\n\"\r\n\r", ",日\"", "\"\r\n" } }, text: "\"\",\"a\",\"日\"\"x ya\",\"\r\nx y\"\r\n\"'\n\"\"\r\n\r\",\",日\"\"\",\"\"\"\r\n\"\r\n" }
