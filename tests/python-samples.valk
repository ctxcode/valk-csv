        WriteSample { rows: .{ .{ "", "# \n#é", "日\r\né", "\"" }, .{ "'\r\né", "\r\n,", "\r\n'", "" }, .{ "", "\r\";日a", ";\na\t7", "\r\n", "é#7a" }, .{ "日\tx y", "x y \r", "'," } }, text: "\t'# \n#é'\t'日\r\né'\t\"\r\n'''\r\né'\t'\r\n,'\t'\r\n'''\t\r\n\t'\r\";日a'\t';\na\t7'\t'\r\n'\té#7a\r\n'日\tx y'\t'x y \r'\t''','\r\n" }
