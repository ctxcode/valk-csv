fn python_writes_single_quote_tab() Array[WriteSample] {
    return .{
        WriteSample { rows: .{ .{ "é'#\n\r\n", "\"é 日" }, .{ "," }, .{ "a'\tb", "", "\r;", "7", "x yé\"é日" } }, text: "'é''#\n\r\n'\t\"é 日\r\n,\r\n'a''\tb'\t\t'\r;'\t7\tx yé\"é日\r\n" }
        WriteSample { rows: .{ .{ ";\r#", "'", "b#ba", "\r\r\n", "#a" }, .{ "x y7',", "", "", ";\r;x y" }, .{ "\"#\r\n", "\ré\"\n7", ";", "x y", "\"\r" } }, text: "';\r#'\t''''\tb#ba\t'\r\r\n'\t#a\r\n'x y7'','\t\t\t';\r;x y'\r\n'\"#\r\n'\t'\ré\"\n7'\t;\tx y\t'\"\r'\r\n" }
