        WriteSample { rows: .{ .{ "", "x y\"", "bab,", "\n;,\r\n" }, .{ "\r\nb," }, .{ "日日x y", ",'\n", "\r" }, .{ "# \"" } }, text: "\"\",\"x y\"\"\",\"bab,\",\"\n;,\r\n\"\r\n\"\r\nb,\"\r\n\"日日x y\",\",'\n\",\"\r\"\r\n\"# \"\"\"\r\n" }
