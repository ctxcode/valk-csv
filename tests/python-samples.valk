        WriteSample { rows: .{ .{ "a\n", "x yb", "é\r\n", "\rb", "\r\n'" }, .{ "" } }, text: "'a\n'\tx yb\t'é\r\n'\t'\rb'\t'\r\n'''\r\n''\r\n" }
        WriteSample { rows: .{ .{ "日", "\"'\"日", "7", "\n,\r\n7" }, .{ "", "日;a'", "\"é", ";;", "\r7'" }, .{ "\n#a;", "\r\n\r'", "\r;x y", "\r\n日" }, .{ "", "aé", "" } }, text: "日\t'\"''\"日'\t7\t'\n,\r\n7'\r\n\t'日;a'''\t\"é\t;;\t'\r7'''\r\n'\n#a;'\t'\r\n\r'''\t'\r;x y'\t'\r\n日'\r\n\taé\t\r\n" }
        WriteSample { rows: .{ .{ "", "\r\n#x y", "\",é" }, .{ "x y", "é日", "\r\"", ";x y" }, .{ "\r\n" }, .{ ";7", "é日x y", "'7", "x y7#é", "b" } }, text: "\t'\r\n#x y'\t\",é\r\nx y\té日\t'\r\"'\t;x y\r\n'\r\n'\r\n;7\té日x y\t'''7'\tx y7#é\tb\r\n" }
        WriteSample { rows: .{ .{ "\r 7\n" }, .{ "\n\n7'", "7\"\"x y", "'\na#b" }, .{ "\n", ",", "" } }, text: "'\r 7\n'\r\n'\n\n7'''\t7\"\"x y\t'''\na#b'\r\n'\n'\t,\t\r\n" }
        WriteSample { rows: .{ .{ "\n#;x y", "'\"a;", "" }, .{ "ax y", "" }, .{ "\r7,'", "\n;; \r" }, .{ "\n" } }, text: "'\n#;x y'\t'''\"a;'\t\r\nax y\t\r\n'\r7,'''\t'\n;; \r'\r\n'\n'\r\n" }
        WriteSample { rows: .{ .{ ",", "\r \"7", "'", "7#" }, .{ "';", "x y\n\n" }, .{ "\r\n\r\né", "b,\n#", "\na" }, .{ "x y\n b'", "é", "", "", "\";;\r" } }, text: ",\t'\r \"7'\t''''\t7#\r\n''';'\t'x y\n\n'\r\n'\r\n\r\né'\t'b,\n#'\t'\na'\r\n'x y\n b'''\té\t\t\t'\";;\r'\r\n" }
        WriteSample { rows: .{ .{ "", "é\r\"'7", ";bé'", "'7'" } }, text: "\t'é\r\"''7'\t';bé'''\t'''7'''\r\n" }
        WriteSample { rows: .{ .{ "", "\"é\r" }, .{ "x yb", "", "bba日", "\"\r\n\n\r\na", ",a\r\n b" } }, text: "\t'\"é\r'\r\nx yb\t\tbba日\t'\"\r\n\n\r\na'\t',a\r\n b'\r\n" }
        WriteSample { rows: .{ .{ "x y \n,", "x y", "" } }, text: "'x y \n,'\tx y\t\r\n" }
