fn python_writes_quote_all() Array[WriteSample] {
    return .{
        WriteSample { rows: .{ .{ "", "x y#\r\n", "\n;", "#," } }, text: "\"\",\"x y#\r\n\",\"\n;\",\"#,\"\r\n" }
