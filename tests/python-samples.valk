        WriteSample { rows: .{ .{ ",x y\"b\n", "", "" }, .{ "b", "'é\r\nb日", "", "x y,\t \r" }, .{ "x yé\r'", "'b\r", "", ";a\t\"" }, .{ "a;\"", "", "\r\n" } }, text: "\",x y\"\"b\n\",\"\",\"\"\r\n\"b\",\"'é\r\nb日\",\"\",\"x y,\t \r\"\r\n\"x yé\r'\",\"'b\r\",\"\",\";a\t\"\"\"\r\n\"a;\"\"\",\"\",\"\r\n\"\r\n" }
