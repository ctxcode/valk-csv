use valk.io
use valk.fs
use valk.mem

/// Reads CSV one row at a time, from text in memory, a file or any `io.Reader`.
///
/// Fields are views of the input: a row costs one array, and only a quoted field with a doubled
/// quote inside is copied. `next_row` and `field` go further and make only the fields you ask
/// for. A source is read in chunks; a chunk stays in memory while a field of it is in use, so a
/// file of any size can be read. A row may run over chunk boundaries and over as many lines as
/// it likes.
///
/// ```valk
/// let reader = csv.Reader.open("users.csv", csv.Options { header: true }) ! panic("%{E.message}")
/// while true {
///     let row = reader.next_map() ! panic("%{E.message} at line %{E.line}")
///     if !isset(row) : break
///     println(row.get("email") !? "")
/// }
/// ```
+ class Reader {
    source: ?io.Reader
    file: ?fs.FileStream
    // The bytes being parsed: the text, or the current chunk, filled up to `end`
    data: String
    at: uint (0)
    end: uint (0)
    chunk_size: uint (65536)
    exhausted: bool (false)
    options: Options
    // Whether the first row is the header; `parse`, `parse_maps` and `decode_to` set it
    use_header: bool
    started: bool (false)
    // Where the field being read starts in `data`, kept when a new chunk is read
    field_start: uint (0)
    in_field: bool (false)
    // A new chunk keeps the row being read in front, so a row is always one range of one chunk
    in_row: bool (false)
    // Fields that need unescaping are built here
    field_buffer: ByteBuffer (.new(64))
    // The line of the next byte
    pos_line: uint (1)
    after_cr: bool (false)
    // The row being read: where it starts in `data`, and its fields. Positions in error messages
    // are computed from these when needed, and strings when a field is asked for
    row_start: uint (0)
    spans: Array[FieldSpan] (.{})
    // Fields that had to be built while reading, which FIELD_BUILT spans point at
    built: Array[String] (.{})
    // Rows read so far, the header included, how many fields the first one had and the last
    rows_read: uint (0)
    width: uint (0)
    last_width: uint (8)
    header_row: Array[String] (.{})
    header_line: uint (0)
    // The index of each header name; the first column wins when a name is used twice
    columns: Map[uint] (.{})
    /// The line the last row that was read starts on, counting from one.
    ~ line: uint (0)

    /// Creates a reader over any `io.Reader`, such as a `fs.FileStream` or a socket.
    ///
    /// The source is read `chunk_size` bytes at a time, at least 4.
    + static fn new(source: io.Reader, options: ?Options (null), chunk_size: uint (65536)) Reader {
        let opts = options ?? Options {}
        check_options(opts)
        return Reader {
            source: source
            file: null
            data: ""
            chunk_size: chunk_size < 4 ? 4 : chunk_size
            options: opts
            use_header: opts.header
        }
    }

    /// Creates a reader over text that is already in memory. The text is not copied, and the
    /// fields it returns are views of it.
    + static fn from_string(text: String, options: ?Options (null)) Reader {
        let opts = options ?? Options {}
        check_options(opts)
        return Reader {
            source: null
            file: null
            data: text
            end: text.length
            options: opts
            use_header: opts.header
        }
    }

    /// Opens a file and reads it `chunk_size` bytes at a time.
    ///
    /// The file closes when it has been read to the end; `close` closes it sooner.
    + static fn open(path: String, options: ?Options (null), chunk_size: uint (65536)) Reader !Error {
        let stream = fs.stream(path) ! throw .io { message: "Cannot open '" + path + "'" }
        let reader = Reader.new(stream, options, chunk_size)
        reader.file = stream
        return reader
    }

    /// Returns the next row, or `null` after the last one.
    ///
    /// Empty lines are skipped unless `skip_empty_lines` is off, and so are comment lines when a
    /// `comment` byte is set. With the `header` option on, the first row is the header, which
    /// `header` returns, and never comes out of here.
    + fn next() ?Array[String] !Error {
        let row = Array[String].new(this.last_width)
        let read = this.next_into(row) !>
        if !read : return null
        return row
    }

    /// Reads the next row into `row`, which is cleared first, and returns whether there was one.
    ///
    /// The same array can take every row in turn, so reading a file allocates nothing per row
    /// besides the fields that need unescaping. Otherwise it behaves like `next`.
    + fn next_into(row: Array[String]) bool !Error {
        row.clear()
        let read = this.next_row() !>
        if !read : return false
        this.copy_fields(row)
        return true
    }

    /// Reads the next row without making its fields, and returns whether there was one.
    ///
    /// `field` and `field_count` read the row until the next read. This is the cheapest way
    /// through a file when you do not need every field. Otherwise it behaves like `next`.
    ///
    /// ```valk
    /// while reader.next_row() ! panic("%{E.message} at line %{E.line}") {
    ///     println(reader.field(2) ?? "")
    /// }
    /// ```
    + fn next_row() bool !Error {
        if !this.started : this.start() !>
        let read = this.read_row() !>
        if !read : return false
        this.check_width() !>
        return true
    }

    /// Returns the number of fields of the last row.
    + get field_count: uint {
        return this.spans.length
    }

    /// Returns field `index` of the last row, or `null` when it has no such field.
    ///
    /// A view of the input unless the field needs unescaping. It stays valid after the next read.
    + fn field(index: uint) ?String {
        if index >= this.field_count : return null
        return this.make_field(index)
    }

    /// Returns the next row as a map from column name to field, or `null` after the last one.
    ///
    /// Needs the `header` option. A row that is shorter than the header leaves its missing
    /// columns out of the map, and fields past the end of the header are dropped; strict mode
    /// turns both into an error.
    + fn next_map() ?Map[String] !Error {
        this.need_header() !>
        let row = this.next() !>
        if !isset(row) : return null
        let map = Map[String]{}
        each this.header_row as name, index {
            if index >= row.length : break
            if !map.has(name) : map.set(name, row.get(index) !? "")
        }
        return map
    }

    /// Returns the next row as an object of your own class or struct, or `null` after the last
    /// one.
    ///
    /// Needs the `header` option: every field of `T` is read from the column with its name, the
    /// way `decode_to` does it.
    ///
    /// ```valk
    /// while true {
    ///     let user = reader.next_to[User]() ! panic("%{E.message} at line %{E.line}")
    ///     if !isset(user) : break
    /// }
    /// ```
    + fn next_to[T]() ?T !Error {
        this.need_header() !>
        let row = this.next() !>
        if !isset(row) : return null
        return decode_row[T](this, row) !>
    }

    /// Returns the header row: empty without the `header` option, or when the input is empty.
    + fn header() Array[String] !Error {
        if !this.started : this.start() !>
        return this.header_row
    }

    /// Returns the index of the column with this name in the header, for `row[index]`.
    ///
    /// Throws `header` when there is no such column, or no header.
    + fn column(name: String) uint !Error {
        this.need_header() !>
        return this.columns.get(name) ! throw .header {
            message: "The header has no column '" + name + "'"
            line: this.header_line
            column: 1
        }
    }

    /// Closes the file that `open` opened. Rows that were not read yet are not returned.
    ///
    /// A reader over another source leaves closing it to its owner.
    + fn close() {
        let file = this.file
        if isset(file) : file.close() _
        this.exhausted = true
        this.at = this.end
    }

    /// Returns the line and column where field `index` of the last row starts, counting from
    /// one; the position of the row itself when it has no such field.
    + fn field_position(index: uint) (uint, uint) {
        let offset = index < this.spans.length ? this.spans[index].offset : 0
        return this.position_at(offset)
    }

    //
    // Rows and fields
    //

    // The byte order mark, and the header when there is one
    fn start() !Error {
        this.started = true
        this.skip_bom() !>
        if !this.use_header : return
        let read = this.read_row() !>
        if !read : return
        this.check_width() !>
        let row = Array[String]{}
        this.copy_fields(row)
        this.header_row = row
        this.header_line = this.line
        each row as name, index {
            if !this.columns.has(name) : this.columns.set(name, index)
        }
    }

    fn need_header() !Error {
        if !this.started : this.start() !>
        if !this.use_header : throw .header { message: "Reading rows by column name needs a header: set `header: true` in the options" }
    }

    // Strict mode: every row has as many fields as the first
    fn check_width() !Error {
        if !this.options.strict : return
        let count = this.field_count
        if this.rows_read == 1 {
            this.width = count
            return
        }
        if count == this.width : return
        // Too many fields: point at the first one too many
        let line = this.line
        let column: uint = 1
        if count > this.width {
            let field_line, field_column = this.field_position(this.width)
            line = field_line
            column = field_column
        }
        throw .fields {
            message: "This row has " + count + " fields, where the first row has " + this.width
            line: line
            column: column
        }
    }

    fn copy_fields(row: Array[String]) {
        each 0 .. this.field_count as i : row.append(this.make_field(i))
    }

    fn make_field(index: uint) String $inline {
        let span = this.spans[index]
        let kind = span.kind
        let length = span.length
        let start = this.row_start + span.offset
        if kind == FIELD_PLAIN : return this.data.range(start, length)
        return this.make_special_field(start, length, kind)
    }

    fn make_special_field(start: uint, length: uint, kind: u8) String {
        if kind == FIELD_QUOTED : return this.data.range(start + 1, length)
        if kind == FIELD_BUILT : return this.built[length]
        let field = this.field_buffer
        field.clear()
        this.unescape(start + 1, start + 1 + length, field)
        return field.to_string()
    }

    // The next row, false at the end of the input
    fn read_row() bool !Error {
        let options = this.options
        while true {
            let more = this.fill() !>
            if !more : return false
            let ch = this.data[this.at]
            if ch == '\n' || ch == '\r' {
                if !options.skip_empty_lines : break
                this.take_line_end() !>
                continue
            }
            if options.comment != 0 && ch == options.comment {
                this.skip_line() !>
                continue
            }
            break
        }
        this.line = this.pos_line
        this.row_start = this.at
        this.in_row = true
        this.spans.clear()
        if this.built.length > 0 : this.built.clear()
        while true {
            let another = this.read_field() !>
            if !another : break
        }
        this.in_row = false
        this.last_width = this.field_count
        this.rows_read++
        return true
    }

    fn add_span(length: uint, kind: u8) $inline {
        this.spans.append(FieldSpan { offset: this.field_start - this.row_start, length: length, kind: kind })
    }

    // Reads one field and the delimiter or line end after it. Returns whether another field
    // follows on the same row.
    fn read_field() bool !Error {
        let options = this.options
        if options.trim : this.skip_blanks() !>
        this.field_start = this.at
        this.in_field = true

        let more = this.fill() !>
        if more && this.data[this.at] == options.quote {
            this.read_quoted() !>
        } else {
            let stop = this.scan_unquoted() !>
            let start = this.field_start
            let length = stop - start
            if options.trim {
                while length > 0 && is_blank(this.data[start + length - 1], options.delimiter) : length--
            }
            this.add_span(length, FIELD_PLAIN)
        }
        this.in_field = false

        more = this.fill() !>
        if !more : return false
        if this.data[this.at] == options.delimiter {
            this.at++
            return true
        }
        this.take_line_end() !>
        return false
    }

    // Moves `at` to the delimiter, the end of the line or the end of the input and returns it;
    // the field starts at `field_start`, which a new chunk keeps
    fn scan_unquoted() uint !Error {
        let delimiter = this.options.delimiter
        let quote = this.options.quote
        let strict = this.options.strict
        while true {
            let more = this.fill() !>
            if !more : return this.at
            let data = this.data
            let end = this.end
            let i = scan_bytes(data, this.at, end, delimiter, '\n', '\r', quote, strict)
            this.at = i
            if i == end : continue
            if strict && data[i] == quote {
                let line, column = this.position_at(this.row_offset(i))
                throw .syntax {
                    message: "A quote inside an unquoted field: quote the whole field, and write the quote twice"
                    line: line
                    column: column
                }
            }
            return i
        }
    }

    // A quoted field at `at`: everything up to the closing quote, where two quotes stand for one.
    // Unescaping copies, when the field is asked for; any other field is a view
    fn read_quoted() !Error {
        let quote = this.options.quote
        let options = this.options
        this.at++
        let escaped = false
        while true {
            let more = this.fill() !>
            if !more {
                let line, column = this.position_at(this.field_start - this.row_start)
                throw .syntax { message: "A quoted field is not closed", line: line, column: column }
            }
            let data = this.data
            let end = this.end
            let from = this.at
            let i = scan_bytes(data, from, end, quote, '\n', '\r', 0, false)
            if i == end {
                if end > from : this.after_cr = false
                this.at = end
                continue
            }
            let ch = data[i]
            if ch == '\n' {
                // Not the second half of a `\r\n` that was split over two reads
                if !(i == from && this.after_cr) : this.pos_line++
                this.after_cr = false
                this.at = i + 1
                continue
            }
            if ch == '\r' {
                this.pos_line++
                this.at = i + 1
                if i + 1 < end {
                    if data[i + 1] == '\n' : this.at = i + 2
                    this.after_cr = false
                } else {
                    this.after_cr = true
                }
                continue
            }
            // The closing quote, or the first of two
            this.at = i + 1
            more = this.fill() !>
            this.after_cr = false
            if more && this.data[this.at] == quote {
                escaped = true
                this.at++
                continue
            }
            break
        }
        // The content as a length: a new chunk read by after_quote moves the offsets
        let content_length = (this.at - 1) - (this.field_start + 1)
        // Text after the closing quote belongs to the field, unless strict mode forbids it
        let trailing = this.after_quote() !>
        let content_start = this.field_start + 1
        if trailing == 0 {
            this.add_span(content_length, escaped ? FIELD_ESCAPED : FIELD_QUOTED)
            return
        }
        let field = this.field_buffer
        field.clear()
        if escaped : this.unescape(content_start, content_start + content_length, field)
        else : field.write(this.data.view(content_start, content_length))
        let quoted = field.length
        field.write(this.data.view(this.at - trailing, trailing))
        if options.trim : trim_end(field, quoted, options.delimiter)
        this.add_span(this.built.length, FIELD_BUILT)
        this.built.append(field.to_string())
    }

    // Writes the quoted content between `start` and `end` with every doubled quote as one
    fn unescape(start: uint, end: uint, field: ByteBuffer) {
        let quote = this.options.quote
        let data = this.data
        let from = start
        while from < end {
            let i = scan_bytes(data, from, end, quote, quote, quote, 0, false)
            if i == end : break
            // Up to and including the first quote of the pair, then past the second
            field.write(data.view(from, i + 1 - from))
            from = i + 2
        }
        if from < end : field.write(data.view(from, end - from))
    }

    // After a closing quote comes the delimiter or the end of the line. Strict mode allows
    // nothing else; otherwise the text is added to the field, as most readers do. Returns the
    // number of bytes of such text, which end at `at`
    fn after_quote() uint !Error {
        let options = this.options
        if options.strict {
            if options.trim : this.skip_blanks() !>
            let more = this.fill() !>
            if !more : return 0
            let ch = this.data[this.at]
            if ch == options.delimiter || ch == '\n' || ch == '\r' : return 0
            let line, column = this.position_at(this.row_offset(this.at))
            throw .syntax {
                message: "Expected the delimiter or the end of the line after the closing quote"
                line: line
                column: column
            }
        }
        // Measured from the field start, which a new chunk keeps in front
        let before = this.at - this.field_start
        let stop = this.scan_unquoted() !>
        return (stop - this.field_start) - before
    }

    fn skip_blanks() !Error {
        let delimiter = this.options.delimiter
        while true {
            let more = this.fill() !>
            if !more : return
            if !is_blank(this.data[this.at], delimiter) : return
            this.at++
        }
    }

    // A comment line, with its line end
    fn skip_line() !Error {
        while true {
            let more = this.fill() !>
            if !more : return
            let data = this.data
            let end = this.end
            let i = this.at
            while i < end {
                let ch = data[i]
                if ch == '\n' || ch == '\r' : break
                i++
            }
            this.at = i
            if i < end {
                this.take_line_end() !>
                return
            }
        }
    }

    // `\n`, `\r\n` or a lone `\r`; `at` is on the first byte
    fn take_line_end() !Error {
        let ch = this.data[this.at]
        this.at++
        if ch == '\r' {
            let more = this.fill() !>
            if more && this.data[this.at] == '\n' : this.at++
        }
        this.pos_line++
    }

    //
    // Positions
    //

    // The offset of the byte at `at` from the start of the row
    fn row_offset(at: uint) uint {
        return at - this.row_start
    }

    // The line and column of the byte `offset` into the row, counted from the row's start
    fn position_at(offset: uint) (uint, uint) {
        let line = this.line
        let column: uint = 1
        let i: uint = 0
        let previous: u8 = 0
        while i < offset {
            let ch = this.data[this.row_start + i]
            if ch == '\n' {
                if previous != '\r' : line++
                column = 1
            } else if ch == '\r' {
                line++
                column = 1
            } else if (ch & 0xc0) != 0x80 {
                // A UTF-8 continuation byte belongs to the character before it
                column++
            }
            previous = ch
            i++
        }
        return (line, column)
    }

    //
    // Bytes
    //

    // Makes sure the byte at `at` is there; false at the end of the input
    fn fill() bool !Error $inline {
        while this.at >= this.end {
            let count = this.read_more() !>
            if count == 0 : return false
        }
        return true
    }

    // Reads from the source into the chunk, into a new one when it is full; returns the bytes
    // that came in, 0 at the end of the input. A new chunk keeps the row being read (or the
    // unread bytes) in front, and grows with it so a long row is not copied again and again
    fn read_more() uint !Error {
        @unsafe
        let source = this.source
        if this.exhausted || !isset(source) : return 0
        if this.end == this.data.length {
            let keep_from = this.in_row ? this.row_start : this.at
            let kept = this.end - keep_from
            let chunk = String.alloc(kept + (kept > this.chunk_size ? kept : this.chunk_size))
            if kept > 0 : mem.copy_bytes(this.data.data.@offset(keep_from), chunk.data, kept)
            this.row_start = 0
            this.at -= keep_from
            this.end = kept
            // Before the first field of a row it is stale, and set before it is read
            this.field_start = this.field_start >= keep_from ? this.field_start - keep_from : 0
            this.data = chunk
        }
        let room = [u8]{ owner: this.data.owner, data: @ref(@ptrv(this.data.data, u8, this.end)), length: this.data.length - this.end }
        let count = source.read(room) ! {
            // A source that was closed has nothing more to give, as for `io.read_all`
            if error_is(E.code, closed) {
                this.exhausted = true
                return 0
            }
            let line = this.pos_line
            let column: uint = 1
            if this.in_field {
                let field_line, field_column = this.position_at(this.row_offset(this.at))
                line = field_line
                column = field_column
            }
            throw .io { message: "Reading the CSV failed", line: line, column: column }
        }
        if count == 0 {
            this.exhausted = true
            return 0
        }
        if count > room.length : count = room.length
        this.end += count
        return count
    }

    // A UTF-8 byte order mark at the very start is not part of the text
    fn skip_bom() !Error {
        // The first bytes may come in one read at a time
        while this.end - this.at < 3 {
            let count = this.read_more() !>
            if count == 0 : break
        }
        let data = this.data
        let at = this.at
        if this.end - at >= 3 && data[at] == 0xef && data[at + 1] == 0xbb && data[at + 2] == 0xbf : this.at += 3
    }
}

// Drops spaces and tabs from the end of `field`, but keeps its first `floor` bytes
fn trim_end(field: ByteBuffer, floor: uint, delimiter: u8) {
    let length = field.length
    while length > floor && is_blank(field[length - 1], delimiter) : length--
    if length < field.length : field.truncate(length)
}

// A field of the row being read: where it starts, counted from the start of the row, and how it
// is held. PLAIN and QUOTED are ranges of the row, ESCAPED is such a range with doubled quotes,
// and BUILT has an index in `built` for its length
struct FieldSpan {
    offset: uint
    length: uint
    kind: u8
}

value FIELD_PLAIN (0)
value FIELD_QUOTED (1)
value FIELD_ESCAPED (2)
value FIELD_BUILT (3)

value SWAR_ONES (0x0101010101010101)
value SWAR_HIGH (0x8080808080808080)

// A high bit in every byte of `word` that equals the byte repeated in `pattern`; only bytes
// after a real match can be wrong, so the lowest one is exact
fn swar_match(word: u64, pattern: u64) u64 $inline {
    let x = word ^ pattern
    return (x - SWAR_ONES) & ~x & SWAR_HIGH
}

// The offset of the first byte of `data` between `from` and `to` that is `a`, `b` or `c` (or
// `d` when `four`), or `to` when there is none: eight bytes at a time, the last eight of a
// longer range read once more so no byte goes through the loop alone
fn scan_bytes(data: String, from: uint, to: uint, a: u8, b: u8, c: u8, d: u8, four: bool) uint $inline {
    @unsafe
    let base = data.data
    let pa = a.to(u64) * SWAR_ONES
    let pb = b.to(u64) * SWAR_ONES
    let pc = c.to(u64) * SWAR_ONES
    let pd = d.to(u64) * SWAR_ONES
    let i = from
    while to - i >= 8 {
        let word = @ptrv(base.@offset(i), u64)
        let hits = swar_match(word, pa) | swar_match(word, pb) | swar_match(word, pc)
        if four : hits = hits | swar_match(word, pd)
        if hits != 0 : return i + hits.trailing_zeros() / 8
        i += 8
    }
    if i == to : return to
    if to - from >= 8 {
        // The last word, with the bytes the loop saw already masked out
        let word = @ptrv(base.@offset(to - 8), u64)
        let hits = swar_match(word, pa) | swar_match(word, pb) | swar_match(word, pc)
        if four : hits = hits | swar_match(word, pd)
        let seen = 8 - (to - i)
        hits = hits >> (seen * 8) << (seen * 8)
        if hits != 0 : return to - 8 + hits.trailing_zeros() / 8
        return to
    }
    while i < to {
        let ch = @ptrv(base, u8, i)
        if ch == a || ch == b || ch == c || (four && ch == d) : return i
        i++
    }
    return to
}
